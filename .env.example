# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/rethink-automotive?retryWrites=true&w=majority

# Auth
AUTH_SECRET=generate-a-secure-random-string-here
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@rethinkautomotive.com
ADMIN_INITIAL_PASSWORD=change-this-secure-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_RECEIVER_EMAIL=contact@rethinkautomotive.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (optional - leave empty until payments are approved)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
